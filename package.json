{
  "name": "pi-chamber",
  "version": "0.1.0",
  "description": "Pi extension package: durable agent identities (Genesis minds), single- and multi-mind conversations (mind, room), and a TUI lens viewer (observatory).",
  "author": "Daniel Scholl",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielscholl/pi-chamber.git"
  },
  "homepage": "https://github.com/danielscholl/pi-chamber#readme",
  "bugs": {
    "url": "https://github.com/danielscholl/pi-chamber/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "multi-agent",
    "minds",
    "chamber",
    "observatory"
  ],
  "files": [
    "*.ts",
    "genesis/**",
    "mind/**",
    "room/**",
    "observatory/**",
    "assembly/**",
    "procedures/**",
    "shared/**",
    "dist/**",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "check": "bun run typecheck && bun test && bun run build"
  },
  "dependencies": {
    "typebox": "^1.1.24",
    "yaml": "^2.8.0",
    "zod": "^3.25.28"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@mariozechner/pi-coding-agent": {
      "optional": true
    },
    "@mariozechner/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "pi": {
    "extensions": [
      "./genesis/index.ts",
      "./mind/index.ts",
      "./room/index.ts",
      "./observatory/index.ts",
      "./assembly/index.ts",
      "./procedures/index.ts"
    ]
  }
}
